FROM python:3.12-slim
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends ffmpeg sox libsndfile1 && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir torch==2.8.0 torchaudio==2.8.0 --index-url https://download.pytorch.org/whl/cpu
COPY backend/requirements-telegram.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt
COPY backend/ /app/backend/
COPY telegram/ /app/telegram/
ENV VOICEBOX_DATA_DIR=/app/data HF_HOME=/app/data/huggingface OMP_NUM_THREADS=2 TOKENIZERS_PARALLELISM=false
EXPOSE 8080
CMD ["sh", "-c", "uvicorn backend.telegram_app:app --host 0.0.0.0 --port ${PORT:-8080} --workers 1"]
